---
// Footer component with TypeScript support
import { getCollection } from 'astro:content';
import { Download } from 'lucide-react';

interface Props {
  currentYear?: number;
  lang?: "ro" | "en";
}

const { currentYear = new Date().getFullYear(), lang = "ro" } = Astro.props;

// Fetch footer content from markdown
const allPages = await getCollection('pages');
const footerContent =
  allPages.find(
    (page) =>
      page.data.pageType === 'footer' &&
      (page.data.lang ? page.data.lang === lang : true)
  ) ||
  allPages.find((page) => page.data.pageType === 'footer');

if (!footerContent) {
  throw new Error('Footer content not found. Please ensure localized footer content exists in src/content/pages/');
}

// Use content from markdown only - no fallbacks
const logoImage = footerContent.data.footerLogoImage;
const brandName = footerContent.data.brandName;
// Split brand name into two lines
const brandNameParts = brandName ? brandName.split(' ') : [];
const brandNameFirst = brandNameParts[0] || '';
const brandNameSecond = brandNameParts.slice(1).join(' ') || '';
const tagline = footerContent.data.tagline;
const quickLinks = footerContent.data.quickLinks;
const resources = footerContent.data.resources;
---

<footer class="footer-bg-accent mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Mobile Layout (below 900px) - Centered and Stacked -->
    <div class="flex flex-col items-center space-y-6 lg:hidden">
      <!-- Logo and Name - Centered, beside each other -->
      <a href="/" class="flex items-center space-x-4 transition-opacity hover:opacity-90">
        <img 
          src={logoImage} 
          alt="VIITOR ACADEMIC Logo" 
            loading="lazy"
          class="h-20 w-auto object-contain"
        />
        <h3 class="text-2xl font-bold text-white leading-tight">
          {brandNameFirst}<br />{brandNameSecond}
        </h3>
      </a>

      <!-- Subtitle -->
      <p class="text-white leading-relaxed text-sm text-center opacity-90 max-w-md">
        {tagline}
      </p>

      <!-- Quick Links - Centered -->
      <div class="space-y-4 text-center">
        <h4 class="text-lg font-semibold text-white">Quick Links</h4>
        <ul class="space-y-2.5">
          {quickLinks && quickLinks.map((link: { name: string; path: string }) => (
            <li>
              <a
                href={link.path}
                class="footer-link text-white hover:text-primary-blue transition-colors text-sm inline-flex items-center group opacity-90 hover:opacity-100 mx-auto"
              >
                <span class="group-hover:translate-x-1 transition-transform inline-block">{link.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources - Centered -->
      <div class="space-y-4 text-center pb-4 border-b border-white/20">
        <h4 class="text-lg font-semibold text-white">Resources</h4>
        <ul class="space-y-2.5">
          {resources && resources.map((link: { name: string; path: string; isExternal?: boolean }) => {
            const linkData = link as { name: string; path: string; isExternal?: boolean };
            const isExternal = linkData.isExternal || linkData.path?.endsWith('.pdf');
            return (
              <li>
                <a
                  href={linkData.path}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class="text-white hover:text-primary-blue transition-colors text-sm inline-flex items-center group opacity-90 hover:opacity-100 mx-auto"
                >
                  {isExternal && (
                    <Download className="w-4 h-4 mr-1.5" />
                  )}
                  <span class="group-hover:translate-x-1 transition-transform inline-block">{linkData.name}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Copyright - Centered -->
      <p class="text-white text-xs opacity-90 text-center">
        © {currentYear} VIITOR ACADEMIC. All rights reserved.
      </p>
    </div>

    <!-- Desktop Layout (900px and above) -->
    <div class="hidden lg:grid grid-cols-12 gap-8">
      <!-- Brand Section -->
      <div class="col-span-4 space-y-4">
        <a href="/" class="flex items-center space-x-4 mb-4 transition-opacity hover:opacity-90">
          <img 
            src={logoImage} 
            alt="VIITOR ACADEMIC Logo" 
            loading="lazy"
            class="h-26 w-auto object-contain"
          />
          <h3 class="text-3xl font-bold text-white leading-tight">
            {brandNameFirst}<br />{brandNameSecond}
          </h3>
        </a>
        <p class="text-white leading-relaxed text-base opacity-90">
          {tagline}
        </p>
      </div>

      <!-- Quick Links and Resources Section - Right Side -->
      <div class="col-span-8 flex justify-end">
        <div class="grid grid-cols-2 gap-16 w-full max-w-2xl">
          <!-- Quick Links Section -->
          <div class="space-y-4">
            <h4 class="text-lg font-semibold text-white">Quick Links</h4>
            <ul class="space-y-2.5">
              {quickLinks && quickLinks.map((link: { name: string; path: string }) => (
                <li>
                  <a
                    href={link.path}
                    class="footer-link text-white hover:text-primary-blue transition-colors text-base inline-flex items-center group opacity-90 hover:opacity-100"
                  >
                    <span class="group-hover:translate-x-1 transition-transform inline-block">{link.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Resources Section -->
          <div class="space-y-4 pb-4 lg:border-b-0 border-b border-white/20">
            <h4 class="text-lg font-semibold text-white">Resources</h4>
            <ul class="space-y-2.5">
              {resources && resources.map((link: { name: string; path: string; isExternal?: boolean }) => {
                const linkData = link as { name: string; path: string; isExternal?: boolean };
                const isExternal = linkData.isExternal || linkData.path?.endsWith('.pdf');
                return (
                  <li>
                    <a
                      href={linkData.path}
                      target={isExternal ? "_blank" : undefined}
                      rel={isExternal ? "noopener noreferrer" : undefined}
                      class="text-white hover:text-primary-blue transition-colors text-base inline-flex items-center group opacity-90 hover:opacity-100"
                    >
                      {isExternal && (
                        <Download className="w-4 h-4 mr-1.5" />
                      )}
                      <span class="group-hover:translate-x-1 transition-transform inline-block">{linkData.name}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar - Desktop Only -->
    <div class="hidden lg:block mt-6 pt-6 border-t border-white/20">
      <div class="flex flex-row justify-between items-center">
        <p class="text-white text-sm opacity-90">
          © {currentYear} VIITOR ACADEMIC. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  // Smooth scroll for footer anchor links with URL hash update
  document.querySelectorAll('footer .footer-link[href^="#"], footer .footer-link[href="/"], footer .footer-link[href="/en"]').forEach((anchor: Element) => {
    const link = anchor as HTMLAnchorElement;
    link.addEventListener('click', (e: Event) => {
      e.preventDefault();
      const href = link.getAttribute('href');
      
      if (href === '/' || href === '/en') {
        // Scroll to top for home
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
        window.history.pushState(null, '', href);
        return;
      }
      
      if (href && href.startsWith('#')) {
        const target = document.querySelector(href);
        if (target) {
          const headerOffset = 80;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });

          // Update URL hash
          window.history.pushState(null, '', href);
        }
      }
    });
  });
</script>

<style>
  footer {
    margin-top: auto;
  }
</style>
